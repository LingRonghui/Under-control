<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标 · 背景层（深空科技）
  深蓝黑径向底 + 掌心位置的极淡翠绿辉光，营造"深空 + 能量场"的空间感。
  纯矢量，任意密度与任意启动器遮罩（圆形/方形/水滴）下都清晰。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 深空底：中心略亮，边缘沉入近黑 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="44"
                android:gradientRadius="76">
                <item android:offset="0" android:color="#FF14212B" />
                <item android:offset="0.45" android:color="#FF0B131B" />
                <item android:offset="1" android:color="#FF04070B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 掌心能量辉光（极淡，避免喧哗） -->
    <path android:pathData="M54,52 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="52"
                android:gradientRadius="34">
                <item android:offset="0" android:color="#1F00C853" />
                <item android:offset="0.62" android:color="#0A00C853" />
                <item android:offset="1" android:color="#0000C853" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
