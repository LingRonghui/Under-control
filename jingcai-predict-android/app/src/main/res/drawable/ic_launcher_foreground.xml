<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标 · 前景层：一颗足球被向上张开的手掌拢在掌心（"逃不出掌心"的掌控感）

  构图口径：
  - 手掌在下、足球在掌心正中央；四指自掌根向上伸展、指尖向内微扣，中指最高、两侧递减；
  - 两根内侧手指被球体遮挡、又从球顶探出 → 形成"球被手指环抱"的包裹关系；
  - 拇指在左下外张，坐实"手掌"的读法；
  - 球体带翠绿能量光环与浅色渐变，配深空底形成科技感。
  所有几何均落在自适应图标安全区（中心 66dp 圆）内，任何遮罩都不会裁切主体。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 能量环：球体后方的翠绿光环（科技感） -->
    <path
        android:pathData="M54,46 m-19.5,0 a19.5,19.5 0 1,0 39,0 a19.5,19.5 0 1,0 -39,0"
        android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="26"
                android:endX="74"
                android:endY="66">
                <item android:offset="0" android:color="#7A00E676" />
                <item android:offset="0.5" android:color="#3319E8B0" />
                <item android:offset="1" android:color="#0019E8B0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== 手：四指（指尖向内微扣，中指最高，两侧递减） ===== -->
    <path
        android:pathData="M35,63 C31,52 31,41 35,31"
        android:strokeWidth="9.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="35" android:startY="31" android:endX="35" android:endY="63">
                <item android:offset="0" android:color="#FFF4F9FF" />
                <item android:offset="1" android:color="#FF9FB4C9" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M47,61 C44,49 44,37 46,25"
        android:strokeWidth="9.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="47" android:startY="25" android:endX="47" android:endY="61">
                <item android:offset="0" android:color="#FFF7FBFF" />
                <item android:offset="1" android:color="#FF9FB4C9" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M61,61 C64,49 64,37 62,25"
        android:strokeWidth="9.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="61" android:startY="25" android:endX="61" android:endY="61">
                <item android:offset="0" android:color="#FFF7FBFF" />
                <item android:offset="1" android:color="#FF9FB4C9" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M73,63 C77,52 77,41 73,31"
        android:strokeWidth="9.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="73" android:startY="31" android:endX="73" android:endY="63">
                <item android:offset="0" android:color="#FFF4F9FF" />
                <item android:offset="1" android:color="#FF9FB4C9" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 拇指：左下外张 -->
    <path
        android:pathData="M34,66 C27,64 23,58 23,52"
        android:strokeWidth="10.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="34" android:startY="66" android:endX="23" android:endY="52">
                <item android:offset="0" android:color="#FFD3E1EE" />
                <item android:offset="1" android:color="#FF8FA5BA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 掌心碗（四指由掌根生出，形成"托举"的底） -->
    <path
        android:pathData="M29,57 C27,71 35,85 54,85 C73,85 81,71 79,57 C70,62 62,64 54,64 C46,64 38,62 29,57 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="57" android:endX="54" android:endY="85">
                <item android:offset="0" android:color="#FFC9DAE9" />
                <item android:offset="1" android:color="#FF6D859C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- ===== 足球：翠绿光环 + 浅色球体 + 拼块 ===== -->
    <path android:pathData="M54,46 m-18,0 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="46"
                android:gradientRadius="18">
                <item android:offset="0" android:color="#5200E676" />
                <item android:offset="0.65" android:color="#1F00C853" />
                <item android:offset="1" android:color="#0000C853" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M54,46 m-13.5,0 a13.5,13.5 0 1,0 27,0 a13.5,13.5 0 1,0 -27,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="45"
                android:startY="36"
                android:endX="64"
                android:endY="58">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="1" android:color="#FF6FE3A6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 拼接缝 -->
    <path
        android:pathData="M54,41.4 L54,32.5 M58.37,44.58 L66.84,41.83 M56.70,49.72 L61.94,56.92 M51.30,49.72 L46.06,56.92 M49.63,44.58 L41.16,41.83"
        android:strokeColor="#66081018"
        android:strokeWidth="1.7"
        android:strokeLineCap="round" />

    <!-- 中央五边形 -->
    <path
        android:pathData="M54,41.4 L58.37,44.58 L56.70,49.72 L51.30,49.72 L49.63,44.58 Z"
        android:fillColor="#FF0A1119" />
</vector>
